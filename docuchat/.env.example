# Database: SQLite by default, PostgreSQL in docker-compose
DATABASE_URL=sqlite:///./docuchat.db
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# LLM + embeddings (OpenAI). Set EMBEDDINGS=fake / LLM=fake to run offline.
OPENAI_API_KEY=sk-...
LLM=openai
CHAT_MODEL=gpt-4o-mini
EMBEDDINGS=openai
EMBED_MODEL=text-embedding-3-small

# RAG tuning knobs
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
CHROMA_DIR=./chroma_data
CACHE_TTL_SECONDS=600
